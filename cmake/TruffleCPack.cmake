set(CPACK_PACKAGE_NAME "Truffle")
set(CPACK_PACKAGE_VENDOR "LooseWired")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Modular graphics framework, composed of independently usable libraries")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_RESOURCE_FILE_LICENSE "${PROJECT_SOURCE_DIR}/LICENSE")
set(CPACK_RESOURCE_FILE_README "${PROJECT_SOURCE_DIR}/README.md")
set(CPACK_SOURCE_GENERATOR "TGZ")
set(CPACK_GENERATOR "TGZ")
if(TFL_OUTPUT_DIR AND NOT DEFINED CPACK_PACKAGE_DIRECTORY)
    get_filename_component(_truffle_package_name "${CMAKE_BINARY_DIR}" NAME)
    set(CPACK_PACKAGE_DIRECTORY "${PROJECT_SOURCE_DIR}/install/${_truffle_package_name}/packages")
endif()

include(CPack)
